# Engine Mode Configuration (true = local Ollama, false = Google Cloud API)
USE_LOCAL_GEMMA=true

# Local Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:latest

# Cloud API Configuration (Google AI Studio)
GEMMA_API_KEY=your_gemini_or_gemma_api_key_here

# Dispatch Targets
GITHUB_TOKEN=ghp_your_personal_access_token_here
GITHUB_DEFAULT_REPO=AtharvVhanalkar/bug-inbox